# Скопируйте в .env и вставьте свой ключ. .env в git не коммитится.
# Ключ: https://aistudio.google.com/ → Get API key (бесплатный тариф)
GEMINI_API_KEY=your_gemini_api_key_here
# Основная модель
GEMINI_MODEL=gemini-3.8-flash
# Запасные модели по порядку: используются, если основная перегружена (503) или недоступна
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
