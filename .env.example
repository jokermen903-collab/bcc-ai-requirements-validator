# Скопируйте в .env и вставьте свои ключи. Файл .env в git не попадает.
# Достаточно одного ключа. Лучший результат даёт ансамбль: Cerebras + Gemini (оба ключа бесплатные).

# Cerebras: https://cloud.cerebras.ai/ → API Keys (бесплатный тариф)
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Google AI Studio: https://aistudio.google.com/ → Get API key (бесплатный тариф)
GEMINI_API_KEY=your_gemini_api_key_here

# Основная модель. С префиксом провайдера (cerebras:, openrouter:, groq:, openai:) — OpenAI-совместимый API,
# без префикса — модель Gemini. Если есть только ключ Gemini, поставьте GEMINI_MODEL=gemini-3.8-flash.
GEMINI_MODEL=cerebras:gpt-oss-120b
# Запасные модели по порядку: если основная перегружена (429/503) или недоступна
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite
# Вторая модель ансамбля: проверяет те же требования параллельно. Пусто — одна модель.
# Модель без ключа пропускается с предупреждением.
ENSEMBLE_MODELS=gemini-3.5-flash-lite

# Необязательно: другие провайдеры
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
